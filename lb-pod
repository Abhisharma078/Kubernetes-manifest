apiVersion: v1
kind: Pod
metadata: 
   name: lb-pod
   labels: 
      app: lb
spec:
  containers:
    - name: nginx-cont
      image: nginx:latest
      ports:
        containerPort: 80
---
apiVersion: v1
kind: Service
metadata:
   name: lb-svc
   labels:
      app: lb
spec:
   type: LoadBalancer
   selector:
     app: lb
   ports:
     - protocol: TCP
       port: 80
       targetPort: 80
   